NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
DATA_MODE=preview
LOCAL_DEV_NO_AUTH=true
# Private deployment: disable bypass; set a long random owner password and session signing secret
OWNER_PASSWORD=
SESSION_SECRET=
# 32 random bytes encoded as base64; required only for database credential storage
CREDENTIAL_ENCRYPTION_KEY=
FRED_API_KEY=
GOLD_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_REQUEST_TIMEOUT_SECONDS=15
GOLD_QUOTE_MIN_CACHE_SECONDS=30
YAHOO_ENABLED=false

# Investment research: use the same state/database for web and MCP. Production uses HTTPS.
ATLAS_PUBLIC_BASE_URL=http://127.0.0.1:3000
ATLAS_AGENT_PUBLIC_URL=http://127.0.0.1:3001
ATLAS_AGENT_PORT=3001
