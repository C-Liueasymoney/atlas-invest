{
  "name": "atlas-invest",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/web.mjs dev",
    "build": "node --env-file-if-exists=.env scripts/web.mjs build",
    "start": "node --env-file-if-exists=.env scripts/web.mjs start",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/db.mjs seed",
    "setup:local": "node scripts/setup.mjs",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,mjs}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,mjs}\" \"scripts/*.mjs\"",
    "data:refresh": "node --env-file-if-exists=.env scripts/refresh-market.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.10"
  }
}
